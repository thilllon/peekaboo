# Secrets & credentials — never commit (gitleaks also blocks these)
# Every env file (.env, .env.production, .env-prod, .envlocal, …) except the keys-only template
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
# Apple signing: App Store Connect API keys (AuthKey_*.p8), certificates, signing requests, keychains
*.p8
*.cer
*.der
*.csr
*.certSigningRequest
*.keychain
*.keychain-db
client_secret*.json
credentials*.json
service-account*.json
.netrc
id_rsa*
id_ed25519*

# Claude Code local state (agent worktrees, local settings)
.claude/worktrees/
.claude/settings.local.json
