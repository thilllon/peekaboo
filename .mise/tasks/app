#!/usr/bin/env bash
#MISE description="Build build/Peekaboo.app (release; CONFIG=debug for debug), version YYYYMMDD-<sha6> and build number (commit count) of HEAD (VERSION= and BUILD= override them), signed with the Developer ID (hardened runtime), else ad-hoc"
# mise runs file tasks from the project root.
set -euo pipefail
source .mise/lib/signing.sh
source .mise/lib/version.sh
load_release_env
CONFIG="${CONFIG:-release}"
# The version of HEAD (YYYYMMDD-<sha6>) and its build number (commits up to HEAD); tests pass VERSION= and BUILD=.
VERSION="${VERSION:-$(head_version || true)}"
BUILD="${BUILD:-$(head_build || true)}"
[[ "$VERSION" =~ ^[0-9]{8}-[0-9a-f]{6}$ ]] || { echo "VERSION must be YYYYMMDD-<sha6>, not \"$VERSION\" (outside a git checkout, set VERSION and BUILD)" >&2; exit 1; }
[[ "$BUILD" =~ ^[1-9][0-9]{0,8}$ ]] || { echo "BUILD must be a positive integer, not \"$BUILD\"" >&2; exit 1; }
IDENTITY="$(sign_identity)"

./.mise/tasks/deps
swift build -c "$CONFIG" --product Peekaboo
BIN_DIR="$(swift build -c "$CONFIG" --show-bin-path)"

APP="$PWD/build/Peekaboo.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN_DIR/Peekaboo" "$APP/Contents/MacOS/Peekaboo"
if [[ "$CONFIG" == release ]]; then
  # The linker's debug map (STABS) names every object file and source folder by absolute path, the home folder
  # included: strip it from the bundle (function names stay for crash reports; `$BIN_DIR/Peekaboo` keeps it for
  # lldb), and refuse to ship a binary that still names a home folder.
  strip -S "$APP/Contents/MacOS/Peekaboo"
  if LC_ALL=C grep -aqF -e /Users/ -e "$HOME/" "$APP/Contents/MacOS/Peekaboo"; then
    echo "Contents/MacOS/Peekaboo still contains an absolute home path:" >&2
    { LC_ALL=C grep -ao '/Users/[[:print:]]*' "$APP/Contents/MacOS/Peekaboo" | sort -u | head -n 5 >&2; } || true
    exit 1
  fi
fi
PLIST="$APP/Contents/Info.plist"
cp Resources/Info.plist "$PLIST"
plutil -replace CFBundleShortVersionString -string "$VERSION" "$PLIST"
plutil -replace CFBundleVersion -string "$BUILD" "$PLIST"
printf 'APPL????' > "$APP/Contents/PkgInfo"
# CLI launcher ships inside the bundle; `mise run install` links it onto PATH.
cp Resources/peekaboo "$APP/Contents/Resources/peekaboo"
cp Resources/AppIcon.icns "$APP/Contents/Resources/AppIcon.icns"
# The statically linked libraries require their license texts with the binary: libjpeg-turbo (IJG, Modified BSD,
# zlib) and libwebp (BSD-3-Clause and its patent grant).
cp .deps/libjpeg-turbo/LICENSE.md "$APP/Contents/Resources/LICENSE-libjpeg-turbo.md"
cp .deps/libwebp/LICENSE.txt "$APP/Contents/Resources/LICENSE-libwebp.txt"

# Hardened runtime in every build, so what runs here is what ships. Releases carry no entitlements: the app needs
# none (the IOSurface SPI is a dlsym into ImageIO, Metal compiles shaders out of process).
if [[ "$IDENTITY" == - && "${RELEASE:-0}" == 1 ]]; then
  # An ad-hoc release (ALLOW_ADHOC=1): no get-task-allow, so other processes cannot attach to the shipped app.
  codesign --force --sign - --options runtime --timestamp=none "$APP"
elif [[ "$IDENTITY" == - ]]; then
  # Ad-hoc: opens on this Mac only; other Macs' Gatekeeper blocks it (releases need a Developer ID).
  # get-task-allow keeps local builds open to lldb and Instruments under the hardened runtime.
  ENTITLEMENTS="$(mktemp)"
  trap 'rm -f "$ENTITLEMENTS"' EXIT
  printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
    '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
    '<plist version="1.0"><dict><key>com.apple.security.get-task-allow</key><true/></dict></plist>' > "$ENTITLEMENTS"
  codesign --force --sign - --options runtime --entitlements "$ENTITLEMENTS" --timestamp=none "$APP"
else
  codesign --force --sign "$IDENTITY" --options runtime --timestamp "$APP"
fi
codesign --verify --strict "$APP"
echo "Peekaboo $VERSION (build $BUILD), $(is_developer_id "$APP" && echo "Developer ID signed" || echo "ad-hoc signed")"
[[ -z "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]] || echo "note: built from a modified working tree" >&2
echo "$APP"
