#!/usr/bin/env bash
#MISE description="Build the app bundle build/Peekaboo.app (release by default; CONFIG=debug for a debug build)"
# mise runs file tasks from the project root.
set -euo pipefail
CONFIG="${CONFIG:-release}"
VERSION="${VERSION:-$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || true)}"
VERSION="${VERSION:-0.1.0}"
BUILD_NUMBER="${BUILD_NUMBER:-$(git rev-list --count HEAD 2>/dev/null || echo 1)}"

swift build -c "$CONFIG" --product Peekaboo
BIN_DIR="$(swift build -c "$CONFIG" --show-bin-path)"

APP="$PWD/build/Peekaboo.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN_DIR/Peekaboo" "$APP/Contents/MacOS/Peekaboo"
cp Resources/Info.plist "$APP/Contents/Info.plist"
/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $VERSION" "$APP/Contents/Info.plist"
/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $BUILD_NUMBER" "$APP/Contents/Info.plist"
printf 'APPL????' > "$APP/Contents/PkgInfo"
if [[ -f Resources/AppIcon.icns ]]; then
  cp Resources/AppIcon.icns "$APP/Contents/Resources/AppIcon.icns"
fi
# Ad-hoc signature: no signing identity is required to run locally.
codesign --force --sign - --timestamp=none "$APP"
echo "$APP"
