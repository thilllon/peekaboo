#!/usr/bin/env bash
#MISE description="Build and install Peekaboo.app into ~/Applications (override with DEST=...)"
#MISE depends=["app"]
set -euo pipefail
DEST="${DEST:-$HOME/Applications}"
mkdir -p "$DEST"
rm -rf "$DEST/Peekaboo.app"
ditto build/Peekaboo.app "$DEST/Peekaboo.app"
# Register with LaunchServices so Finder's "Open With" and `open -a Peekaboo` find it.
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$DEST/Peekaboo.app"
echo "Installed: $DEST/Peekaboo.app"
