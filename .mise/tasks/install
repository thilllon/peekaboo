#!/usr/bin/env bash
#MISE description="Build and install Peekaboo.app into ~/Applications and link the peekaboo CLI into ~/.local/bin (override with DEST=, BIN_DIR=)"
#MISE depends=["app"]
set -euo pipefail
DEST="${DEST:-$HOME/Applications}"
mkdir -p "$DEST"
rm -rf "$DEST/Peekaboo.app"
ditto build/Peekaboo.app "$DEST/Peekaboo.app"
# Register with LaunchServices so Finder's "Open With" and `open -a Peekaboo` find it.
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$DEST/Peekaboo.app"
echo "Installed: $DEST/Peekaboo.app"

# CLI launcher: `peekaboo <image-or-folder> ...` (override the link directory with BIN_DIR=...).
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"
mkdir -p "$BIN_DIR"
ln -sf "$DEST/Peekaboo.app/Contents/Resources/peekaboo" "$BIN_DIR/peekaboo"
echo "Linked:    $BIN_DIR/peekaboo"
case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *) echo "warning: $BIN_DIR is not on PATH" >&2 ;;
esac
