#!/usr/bin/env bash
#MISE description="Release HEAD of main as YYYYMMDD-<sha6> (build number = commit count): Developer ID signed + notarized app and DMG, tag v<version> and GitHub Release \"Peekaboo <version>\" with Peekaboo-<version>.dmg, Peekaboo-<version>.zip and latest.json; NOTES_FILE= gives the release notes (default: generated). DRY_RUN=1 prints the notarization and publishing commands; ALLOW_ADHOC=1 publishes without a Developer ID"
# mise runs file tasks from the project root.
set -euo pipefail
source .mise/lib/signing.sh
source .mise/lib/version.sh
load_release_env
REPO=thilllon/peekaboo
# A failed precondition stops a release; a dry run reports it and goes on, to show the rest.
fail() {
  if dry; then echo "DRY_RUN: a release would stop here: $*" >&2; else echo "$*" >&2; exit 1; fi
}

# 1. A clean main, in sync with origin.
[[ "$(git rev-parse --abbrev-ref HEAD)" == main ]] || fail "release from main"
git diff --quiet && git diff --cached --quiet || fail "the working tree is not clean"
git fetch -q --tags origin main
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] || fail "main is not in sync with origin/main"
# The build number counts commits: a shallow clone would count too few.
[[ "$(git rev-parse --is-shallow-repository)" == false ]] || fail "a shallow clone: git fetch --unshallow first"
dry || gh auth status >/dev/null 2>&1 || fail "gh is not logged in (gh auth login)"
# The tag is public and carries the tagger: never a personal address (a clone without this repo's git config would use
# the global one).
[[ "$(git config user.email)" == *@users.noreply.github.com ]] ||
  fail "git config user.email must be the GitHub noreply address, not $(git config user.email)"
[[ -z "${NOTES_FILE:-}" || -s "$NOTES_FILE" ]] || fail "NOTES_FILE=$NOTES_FILE is missing or empty"

# 2. The version of HEAD: YYYYMMDD-<sha6> (the same commit always gets the same one) and its build number, which
#    must be above the latest release's (the updater installs only higher builds).
[[ $# -eq 0 ]] || { echo "usage: mise run release (the version comes from HEAD: YYYYMMDD-<sha6>)" >&2; exit 1; }
SHA="$(git rev-parse HEAD)"  # the commit built, tagged and released, whatever happens to the checkout meanwhile
VERSION="$(head_version)"
BUILD="$(head_build)"
TAG="v$VERSION"
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null || git ls-remote --exit-code --tags origin "refs/tags/$TAG" >/dev/null; then
  echo "$TAG exists: HEAD is released already" >&2
  exit 1
fi
# The latest release's manifest (none before the first release with an updater, v0.1.0).
LATEST_BUILD="$(curl -fsSL "https://github.com/$REPO/releases/latest/download/latest.json" 2>/dev/null \
  | plutil -extract build raw -o - - 2>/dev/null || echo 0)"
(( BUILD > LATEST_BUILD )) || fail "build $BUILD is not above the latest release's build $LATEST_BUILD"
echo "releasing Peekaboo $VERSION (build $BUILD) as $TAG"

# 3. A Developer ID, or an explicit ad-hoc release (it will not open on other Macs without "Open Anyway").
if [[ "$(sign_identity)" == - && "${ALLOW_ADHOC:-0}" != 1 ]]; then
  fail "no Developer ID Application identity in the keychain (see AGENTS.md, Releases); ALLOW_ADHOC=1 publishes an ad-hoc build"
fi

# 4. Build, sign, notarize, staple: build/Peekaboo.app, build/Peekaboo-$VERSION.zip and .dmg.
RELEASE=1 VERSION="$VERSION" BUILD="$BUILD" ./.mise/tasks/app
NOTARIZE=1 ./.mise/tasks/dmg
APP=build/Peekaboo.app
ZIP="build/Peekaboo-$VERSION.zip"
DMG="build/Peekaboo-$VERSION.dmg"
if is_developer_id "$APP"; then
  dry || { xcrun stapler validate -q "$APP" && xcrun stapler validate -q "$DMG"; } || fail "the app or the DMG is not notarized"
elif [[ "${ALLOW_ADHOC:-0}" != 1 ]]; then
  fail "the app is not Developer ID signed"
fi
# The updater accepts only updates signed by the running app's team: a release from another team would strand users.
if [[ -n "${TEAM_ID:-}" ]] && is_developer_id "$APP" && [[ "$(team_id "$APP")" != "$TEAM_ID" ]]; then
  fail "the app is signed by team $(team_id "$APP"), not $TEAM_ID (APPLE_TEAM_ID of .env.production)"
fi

# 5. latest.json: what the in-app updater reads (Sources/PeekabooCore/Update/UpdateManifest.swift).
BASE="https://github.com/$REPO/releases/download/$TAG"
cat > build/latest.json <<JSON
{
  "version": "$VERSION",
  "build": $BUILD,
  "minimumSystemVersion": "$(plutil -extract LSMinimumSystemVersion raw -o - "$APP/Contents/Info.plist")",
  "url": "$BASE/Peekaboo-$VERSION.zip",
  "sha256": "$(shasum -a 256 "$ZIP" | awk '{ print $1 }')",
  "size": $(stat -f %z "$ZIP"),
  "dmg": "$BASE/Peekaboo-$VERSION.dmg",
  "notes": "https://github.com/$REPO/releases/tag/$TAG",
  "published": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
JSON
plutil -convert xml1 -o /dev/null build/latest.json
cat build/latest.json

# 6. Tag, push the tag, publish.
[[ "$(git rev-parse HEAD)" == "$SHA" ]] && git diff --quiet && git diff --cached --quiet ||
  fail "the checkout changed while releasing: not tagging $SHA"
run git tag -a "$TAG" "$SHA" -m "Peekaboo $VERSION"
run git push -q origin "refs/tags/$TAG"
NOTES=(--generate-notes)
[[ -n "${NOTES_FILE:-}" ]] && NOTES=(--notes-file "$NOTES_FILE")
run gh release create "$TAG" "$DMG" "$ZIP" build/latest.json --repo "$REPO" \
  --title "Peekaboo $VERSION" "${NOTES[@]}" --latest --verify-tag
if dry; then echo "DRY_RUN: nothing was tagged or published"; else echo "released $TAG"; fi
