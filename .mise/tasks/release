#!/usr/bin/env bash
#MISE description="Release: tag v<version> on main, build the DMG and publish it as a GitHub Release (mise run release 0.1.0)"
# mise runs file tasks from the project root.
set -euo pipefail
VERSION="${1:?usage: mise run release <version>, e.g. 0.1.0}"
[[ "$(git rev-parse --abbrev-ref HEAD)" == main ]] || { echo "release from main" >&2; exit 1; }
git diff --quiet && git diff --cached --quiet || { echo "working tree is not clean" >&2; exit 1; }
git fetch -q origin main
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] || { echo "main is not in sync with origin/main" >&2; exit 1; }
VERSION="$VERSION" ./.mise/tasks/app
./.mise/tasks/dmg
git tag -a "v$VERSION" -m "Peekaboo $VERSION"
git push -q origin "v$VERSION"
gh release create "v$VERSION" build/Peekaboo.dmg --title "Peekaboo $VERSION" --generate-notes
echo "released v$VERSION"
